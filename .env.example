# ---------- Backend / worker ----------
APP_ENV=development
LOG_LEVEL=INFO

# Supabase PostgreSQL connection string (Project Settings -> Database). Use the pooler/direct URL.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase Auth. Use SUPABASE_URL (JWKS, recommended for asymmetric signing keys)
# and/or SUPABASE_JWT_SECRET (legacy HS256 projects).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=http://localhost:3000

# Ollama (use http://host.docker.internal:11434 to reach Ollama running on the host from Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192

# Official YouTube Data API v3 key (first permitted social integration). Optional; without it YouTube is reported as inaccessible.
YOUTUBE_API_KEY=

# Crawling
CRAWL_MAX_PAGES=10
DOMAIN_MIN_INTERVAL_SECONDS=1.0
RESPECT_ROBOTS_TXT=true

# Worker
WORKER_CONCURRENCY=2

# ---------- Frontend (public values only; never put the service-role key here) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
